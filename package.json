{
  "name": "0628dao-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Development-only CAW game modules and ThreeCore offline runtime simulation.",
  "scripts": {
    "compile": "node scripts/compile.js",
    "static": "node scripts/static-check.js",
    "lint:solidity": "solhint --disc \"game/**/*.sol\" \"threecore/testnet/contracts/*.sol\"",
    "test": "npm run compile && mocha --timeout 30000 \"game/test/**/*.test.js\"",
    "audit": "npm audit --audit-level=high",
    "check": "npm run static && npm run lint:solidity && npm test && npm run test:threecore && npm run test:testnet && npm run test:testnet-ui && npm run audit",
    "test:threecore": "node --test threecore/test/*.test.js",
    "demo:threecore": "node threecore/examples/simulate.js",
    "preflight:threecore": "node threecore/scripts/preflight.js",
    "test:testnet": "npm run compile && mocha --timeout 30000 \"threecore/testnet/test/*.test.js\"",
    "build:testnet": "npm run compile && node threecore/testnet/scripts/build-web.js",
    "deploy:testnet": "npm run compile && node threecore/testnet/scripts/deploy.js",
    "check:testnet": "npm run compile && node threecore/testnet/scripts/deploy.js --check",
    "test:testnet-ui": "npm run build:testnet && node threecore/testnet/test/ui-controller.mjs"
  },
  "devDependencies": {
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "hardhat": "3.16.0",
    "mocha": "12.0.0",
    "solc": "0.8.30",
    "solhint": "6.2.4"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "tmp": "0.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
