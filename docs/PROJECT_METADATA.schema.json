{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0628DAO/0628DAO-Protocol/blob/main/docs/PROJECT_METADATA.schema.json",
  "title": "0628DAO protocol project metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verifiedAt",
    "status",
    "projectSummary",
    "lineage",
    "repositories",
    "documentRegistry"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "status": {
      "type": "object",
      "required": ["stage", "audited", "testnetDeployed", "mainnetDeployed"],
      "properties": {
        "stage": { "const": "development" },
        "audited": { "const": false },
        "testnetDeployed": { "const": false },
        "mainnetDeployed": { "const": false }
      }
    },
    "projectSummary": { "type": "object" },
    "lineage": { "type": "object" },
    "repositories": { "type": "object" },
    "documentRegistry": {
      "type": "object",
      "required": [
        "humanReadableFile",
        "sourceSystem",
        "publicFields",
        "accessBearingReferencesPublished",
        "privateSourceDerivedSummariesPublished"
      ]
    }
  }
}
